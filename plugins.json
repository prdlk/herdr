        "command": [
          "sh",
          "-c",
          "exec sh \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" toggle"
        ]
      }
    ],
    "panes": [
      {
        "id": "picker",
        "title": "open file",
        "placement": "popup",
        "command": [
          "sh",
          "-c",
          "exec sh \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" picker"
        ]
      }
    ],
    "link_handlers": [
      {
        "id": "file-path",
